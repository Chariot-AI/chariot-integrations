# Pipecat voice agent with Chariot STT and TTS. Copy to .env and fill in your keys.

# Chariot: get a key at platform.chariot.in, pick a voice from GET /v1/voices
CHARIOT_API_KEY=your-api-key-here
CHARIOT_VOICE_ID=your-voice-uuid
CHARIOT_MODEL=chariot-multilingual-v1

# OpenAI: used for the LLM only in this example
OPENAI_API_KEY=your-openai-key-here

# Streaming ASR: none = automatic language detection
CHARIOT_ASR_LANGUAGE=none
CHARIOT_ASR_MODE=balanced
CHARIOT_ASR_STYLE=codemix
CHARIOT_ASR_COMMIT_STRATEGY=manual
